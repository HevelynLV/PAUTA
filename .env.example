# Modelo do .env.local. Copie para .env.local e preencha os valores.
# Este arquivo vai para o GitHub: nunca coloque valores reais aqui.
# Onde pegar cada valor: README.md, passo 4.

# Endereço do projeto Supabase (Project Settings → Data API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (Project Settings → API Keys → Publishable key, começa com sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço do site, sem barra no fim. Em desenvolvimento, sempre este:
SITE_URL=http://localhost:3000

# Chave secreta: os testes automáticos (passo 1.6) e o servidor do app, só em
# src/lib/supabase/admin.ts (excluir assinante pendente, passo 5.2).
# Pessoal: cada um cria a sua. Na Vercel (Etapa 13) vai uma chave de produção separada.
# Nunca com NEXT_PUBLIC_, nunca no código do navegador, nunca no GitHub.
SUPABASE_SECRET_KEY=

# Segredo da assinatura do contrato (auditoria da Etapa 9): o servidor assina o PDF
# conferido e o banco confere com o mesmo valor, guardado no Vault com o nome
# pauta_contrato_pdf. Igual para as duas pessoas, porque o banco é um só: quem criou
# passa o valor por mensagem particular. Nunca com NEXT_PUBLIC_, nunca no GitHub.
CONTRATO_PDF_SEGREDO=

# WhatsApp (Etapa 10). Sem as três primeiras, o WhatsApp é pulado e o aviso no app
# é criado do mesmo jeito. Nunca com NEXT_PUBLIC_, nunca no GitHub.
# Token e ID do número: painel da Meta (developers.facebook.com → app → WhatsApp →
# Step 1. Try it out). Pessoais: cada um usa o do próprio app de teste.
WHATSAPP_TOKEN=
WHATSAPP_NUMERO_ID=
# Segredo da fila do WhatsApp (passo 10.3b): o banco só entrega a fila (com os telefones)
# a quem tem o mesmo valor, guardado no Vault com o nome pauta_whatsapp_fila. Igual para
# as duas pessoas, como o CONTRATO_PDF_SEGREDO: quem criou passa por mensagem particular.
WHATSAPP_FILA_SEGREDO=
# Opcional: modelo aprovado na Meta, com dois parâmetros no corpo (título e texto).
# Padrão: aviso_pauta (criar e aprovar antes do piloto, Etapa 13).
WHATSAPP_MODELO=
